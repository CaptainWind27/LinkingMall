<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.youko.customerfrontstage.mapper.PictureMapper">
    <select id="getPic" resultType="com.youko.customerfrontstage.bean.PicturePath">
        select * from picture_path where spu_id = #{spuID}
    </select>
    <select id="getMainPagePic" resultType="com.youko.customerfrontstage.bean.PicturePath">
        select * from picture_path where spu_id = #{spuID} and main_page_pic = true
    </select>
</mapper>